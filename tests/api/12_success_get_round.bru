meta {
  name: Получить созданный раунд
  type: http
  seq: 12
}
get {
  url: {{baseUrl}}/api/game/state/{{gameId}}
  body: none
  auth: none
}
headers {
  X-Player-Id: {{playerId}}
}
tests {
  test("returns state for the created round", function() {
    expect(res.status).to.equal(200);
    expect(res.body.gameId).to.equal(bru.getEnvVar("gameId"));
    expect(res.body).to.have.property("status");
  });
}
