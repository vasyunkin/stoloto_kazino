meta {
  name: Подготовить player JWT для проверки доступа
  type: http
  seq: 9
}
post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}
headers {
  Content-Type: application/json
}
body:json {
  {"email":"{{$randomEmail}}","password":"ValidPass123"}
}
tests {
  test("registers a player and stores token", function() {
    expect(res.status).to.equal(201);
    expect(res.body.accessToken).to.be.a("string");
    bru.setEnvVar("playerAccessToken", res.body.accessToken);
  });
}
