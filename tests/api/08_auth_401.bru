meta {
  name: Ошибка 401 — неверный API ключ
  type: http
  seq: 8
}
get {
  url: {{baseUrl}}/api/admin/config
  body: none
  auth: none
}
headers {
  X-Admin-Key: {{invalidAdminKey}}
}
tests {
  test("returns 401 problem details", function() {
    expect(res.status).to.equal(401);
    expect(res.headers["content-type"]).to.contain("application/problem+json");
    expect(res.body.status).to.equal(401);
  });
}
