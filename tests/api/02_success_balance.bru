meta {
  name: Получить баланс игрока
  type: http
  seq: 2
}
get {
  url: {{baseUrl}}/api/players/{{playerId}}/balance
  body: none
  auth: none
}
headers {
  X-Player-Id: {{playerId}}
}
tests {
  test("returns 200 with balance", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("balance");
  });
}
